SINGBOX_SHA256_amd64=e2bdf179c15a3652955dc44867e33ca0965c9c9b91b34267dcc5a5d639a5feee
SINGBOX_SHA256_arm64=29dae24d76bea3bc62d07dd3e60cfc12003de7debbd6b768df9be9c68360174e

# ---------- age (шифрование сырых отчётов пробника для history/, zoo history export) ----------
# https://github.com/FiloSottile/age/releases/tag/v1.3.2 (2026-08-29). Хеши проверены скачиванием
# 2026-10-05 и совпали с digest ассетов GitHub. Сервер: фаза 09 кладёт age в /usr/local/lib/vpn-zoo/bin
# (не в PATH); образ zoo-probe — в /usr/local/bin. Windows-архив — для владельца (scripts/history.sh install-age).
AGE_VERSION=v1.3.2
AGE_URL_BASE=https://github.com/FiloSottile/age/releases/download/v1.3.2
AGE_SHA256_amd64=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
AGE_SHA256_arm64=6b8dc4333c53a5a57c9e5834e3a48f92605d7154014cd07269ff3327db5d37f4
AGE_SHA256_windows_amd64=f48d8f8f9ebe903ab5027ed067652f2cc1db94bc206976430133b905dcd8e8c7
