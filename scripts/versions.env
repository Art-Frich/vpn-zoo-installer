# versions.env — закреплённые версии и sha256 внешних компонентов (D1).
# Каждый хеш проверен скачиванием (дата — в комментарии блока) и совпал с хешем, опубликованным upstream.
# Обновление: поменять версию и хеши, прогнать docker/test.sh, затем `zoo upgrade`.
# Файл source'ится из lib.sh (versions_load). Только присваивания, без логики.

# ---------- 3x-ui (панель + встроенный Xray) ----------
# https://github.com/MHSanaei/3x-ui/releases/tag/v3.10.2 (2026-10-14)
# upstream публикует <архив>.sha256 рядом с архивом (с v3.8.0); хеши ниже проверены
# скачиванием 2026-10-24 и совпадают с ним (и с digest ассетов GitHub)
XUI_VERSION=v3.10.2
XUI_URL_BASE=https://github.com/MHSanaei/3x-ui/releases/download/v3.10.2
XUI_SHA256_amd64=bfda7921984e7a72555c38d4e861c7a8b67b3686b658608937de99682f1452d0
XUI_SHA256_arm64=a867c65ce52ad49f6504dd4c9c395337dc92ba57ae478da4f1b7ddb624014ed5
# Xray внутри архива v3.10.2 (`xray-linux-<arch> version`: 26.10.10, коммит 701af60, go1.27.2);
# у XTLS/Xray-core тега v26.10.10 нет — это сборка 3x-ui между релизами 26.9.30 (pre-release)
# и 26.10.21. Отдельно Xray не качаем
XUI_XRAY_VERSION=26.10.10

# ---------- Hysteria2 ----------
# Репозиторий переехал apernet/hysteria -> HyNetworks/hysteria (редирект работает).
# Тег app/v2.13.0 (2026-10-05), хеши проверены скачиванием 2026-10-24 и совпадают с hashes.txt релиза.
HY2_VERSION=v2.13.0
HY2_URL_BASE=https://github.com/HyNetworks/hysteria/releases/download/app%2Fv2.13.0
HY2_SHA256_amd64=907ba8c9693edb104b20582681fb7dc15639d5b64a9cbb616a7b539190a86691
HY2_SHA256_arm64=a68a61a84452ca250ce0368202521965ca9cc9d801a404f1dc9008ac6cf677a7

# ---------- AmneziaWG userspace (amneziawg-go + amneziawg-tools) ----------
# У amneziawg-go нет бинарных релизов, только теги: собираем из исходников.
# go.mod требует go >= 1.25. *_SRC_SHA256 — архив GitHub refs/tags/<ref>.tar.gz;
# GitHub не гарантирует побайтную стабильность таких архивов, поэтому дополнительно
# закреплён commit: при несовпадении sha256 сверять git-коммит тега.
AWG_GO_REF=v3.1.20260828
AWG_GO_COMMIT=b5928efb6ca19f0153958460c3d141f04abc5c2e
AWG_GO_SRC_URL=https://github.com/amnezia-vpn/amneziawg-go/archive/refs/tags/v3.1.20260828.tar.gz
AWG_GO_SRC_SHA256=24c656cfb80ff6855702710eaf2e3729fa710bf6bfdbbbdfba01984ccd17de95
AWG_TOOLS_REF=v3.1.20260812
AWG_TOOLS_COMMIT=ee0f0a9aa34ff0a0da4b3433b9512781cfe02843
AWG_TOOLS_SRC_URL=https://github.com/amnezia-vpn/amneziawg-tools/archive/refs/tags/v3.1.20260812.tar.gz
AWG_TOOLS_SRC_SHA256=dbd8ce0748d835d18f30bb76720246b7bfc80bd09cd17c379b1c59f683a18493
# Готовые awg/awg-quick из релиза tools (только x86-64, собраны на ubuntu-22.04)
AWG_TOOLS_BIN_URL=https://github.com/amnezia-vpn/amneziawg-tools/releases/download/v3.1.20260812/ubuntu-22.04-amneziawg-tools.zip
AWG_TOOLS_BIN_SHA256_amd64=919e9d0a367c7c72f9c16b7d0a9e4840b943628353b2210a33cb4b582785ba56

# Go-тулчейн для сборки amneziawg-go (https://go.dev/dl/)
# 1.27.3, хеши — поле sha256 из https://go.dev/dl/?mode=json, проверены скачиванием 2026-10-24
GO_VERSION=1.27.3
GO_URL_BASE=https://go.dev/dl
GO_SHA256_amd64=65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40
GO_SHA256_arm64=a06e99309dbcbdca1a8ccd2282c3ee146e55930886e26b4f1193269587165f49

# Ядра, на которых DKMS amneziawg 3.1 из PPA не собирается (#259): 7.0.0-38 и новее,
# пока фикс не влит. Регэксп по `uname -r`.
AWG_KMOD_BROKEN_KERNELS='^7\.0\.0-(3[89]|[4-9][0-9]|[1-9][0-9]{2,})-'

# ---------- geo-файлы (routing Xray) ----------
# Те же источники, что в списке обновлений 3x-ui (geofileAllowlist).
# geoip_RU.dat в архиве 3x-ui v3.10.2 не равен ни одному релизу runetfreedom (сверено 300
# релизов с 07.2026 по 23.10.2026), поэтому фаза 07 ставит закреплённый релиз ниже
# (хеши совпадают с <файл>.sha256sum релиза, проверено скачиванием 2026-10-24).
# Таймер обновления (фаза 07) берёт latest и сверяет с <файл>.sha256sum релиза.
GEO_RU_REPO=runetfreedom/russia-v2ray-rules-dat
GEO_RU_TAG=202610231928
GEO_RU_GEOIP_SHA256=54f83b5b55736cf156f54d5da568cf94526748f7dbffb3f95a1f68d94322b22a
GEO_RU_GEOSITE_SHA256=76fdbe01687a6cc7683b50c38ceea84941458e8371d215918daf555665a537cd
# geoip.dat/geosite.dat в архиве 3x-ui v3.10.2 побайтно равны релизу Loyalsoldier 202610132205
GEO_REPO=Loyalsoldier/v2ray-rules-dat
GEO_TAG=202610132205
GEO_GEOIP_SHA256=116cc0f03d48991962f7f9cdbbcf53d45d89777f9c3cd1a663210853e5df6093
GEO_GEOSITE_SHA256=c5a73fbd415bb0506ecf8fa574caadc6f54a71d9308c265e97da49e4cebf8466

