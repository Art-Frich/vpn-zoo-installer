# versions.env — закреплённые версии и sha256 внешних компонентов (D1).
# Каждый хеш проверен скачиванием 2026-10-04 и совпал с хешем, опубликованным upstream.
# Обновление: поменять версию и хеши, прогнать docker/test.sh, затем `zoo upgrade`.
# Файл source'ится из lib.sh (versions_load). Только присваивания, без логики.

# ---------- 3x-ui (панель + встроенный Xray) ----------
# https://github.com/MHSanaei/3x-ui/releases/tag/v3.9.0 (2026-10-03)
# upstream публикует <архив>.sha256 рядом с архивом (с v3.8.0); хеш ниже совпадает с ним
XUI_VERSION=v3.9.0
XUI_URL_BASE=https://github.com/MHSanaei/3x-ui/releases/download/v3.9.0
XUI_SHA256_amd64=d7cbe0bf6358ee0d2117c24fd2efb483502e411d38e2ea59bd0bf5e7a3e39390
XUI_SHA256_arm64=9a2e43c976a2e71618a30d8f38b52476b25ed363c6989599e2f625cc52f51a81
# Xray внутри архива v3.9.0 (`xray-linux-<arch> version`); отдельно Xray не качаем
XUI_XRAY_VERSION=26.9.30

# ---------- Hysteria2 ----------
# Репозиторий переехал apernet/hysteria -> HyNetworks/hysteria (редирект работает).
# Тег app/v2.12.3 (2026-09-16), хеши совпадают с hashes.txt релиза.
HY2_VERSION=v2.12.3
HY2_URL_BASE=https://github.com/HyNetworks/hysteria/releases/download/app%2Fv2.12.3
HY2_SHA256_amd64=8c7a68a906998b747a0db87586e364f995fbfddb95693ae6e2fdb68a6e920d3e
HY2_SHA256_arm64=c8dc653c3ba0a28d29a26b8fa52d2086f27c0927afddce95c09965e7174e78b0

# ---------- AmneziaWG userspace (amneziawg-go + amneziawg-tools) ----------
# У amneziawg-go нет бинарных релизов, только теги: собираем из исходников.
# go.mod требует go >= 1.25. *_SRC_SHA256 — архив GitHub refs/tags/<ref>.tar.gz;
# GitHub не гарантирует побайтную стабильность таких архивов, поэтому дополнительно
# закреплён commit: при несовпадении sha256 сверять git-коммит тега.
AWG_GO_REF=v3.1.20260828
AWG_GO_COMMIT=b5928efb6ca19f0153958460c3d141f04abc5c2e
AWG_GO_SRC_URL=https://github.com/amnezia-vpn/amneziawg-go/archive/refs/tags/v3.1.20260828.tar.gz
AWG_GO_SRC_SHA256=24c656cfb80ff6855702710eaf2e3729fa710bf6bfdbbbdfba01984ccd17de95
AWG_TOOLS_REF=v3.1.20260812
AWG_TOOLS_COMMIT=ee0f0a9aa34ff0a0da4b3433b9512781cfe02843
AWG_TOOLS_SRC_URL=https://github.com/amnezia-vpn/amneziawg-tools/archive/refs/tags/v3.1.20260812.tar.gz
AWG_TOOLS_SRC_SHA256=dbd8ce0748d835d18f30bb76720246b7bfc80bd09cd17c379b1c59f683a18493
# Готовые awg/awg-quick из релиза tools (только x86-64, собраны на ubuntu-22.04)
AWG_TOOLS_BIN_URL=https://github.com/amnezia-vpn/amneziawg-tools/releases/download/v3.1.20260812/ubuntu-22.04-amneziawg-tools.zip
AWG_TOOLS_BIN_SHA256_amd64=919e9d0a367c7c72f9c16b7d0a9e4840b943628353b2210a33cb4b582785ba56

# Go-тулчейн для сборки amneziawg-go (https://go.dev/dl/)
GO_VERSION=1.27.1
GO_URL_BASE=https://go.dev/dl
GO_SHA256_amd64=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445
GO_SHA256_arm64=3450b45a3f9ee8568792736a5c5e70a1f2e9b36c35a8f74958c03e51d7d92bec

# Ядра, на которых DKMS amneziawg 3.1 из PPA не собирается (#259): 7.0.0-38 и новее,
# пока фикс не влит. Регэксп по `uname -r`.
AWG_KMOD_BROKEN_KERNELS='^7\.0\.0-(3[89]|[4-9][0-9]|[1-9][0-9]{2,})-'

# ---------- geo-файлы (routing Xray) ----------
# Те же источники, что в списке обновлений 3x-ui (geofileAllowlist в v3.9.0).
# geoip_RU/geosite_RU в архиве 3x-ui v3.9.0 побайтно равны релизу 202610031847.
# Таймер обновления (фаза 07) берёт latest и сверяет с <файл>.sha256sum релиза.
GEO_RU_REPO=runetfreedom/russia-v2ray-rules-dat
GEO_RU_TAG=202610031847
GEO_RU_GEOIP_SHA256=a7fe0ab28cadaaaed70891695ff3f9f6b4425cba244e4206594c95e04ebf8669
GEO_RU_GEOSITE_SHA256=76fdbe01687a6cc7683b50c38ceea84941458e8371d215918daf555665a537cd
GEO_REPO=Loyalsoldier/v2ray-rules-dat
GEO_TAG=202610032254
GEO_GEOIP_SHA256=391b522361c52804e486a98b53d97f3d9c1d3e4e4217bb34954774a0b456b9fd
GEO_GEOSITE_SHA256=59b6ed33176b6f03debcfa3105d42de268475ffa8a1e010f481985256e375262
