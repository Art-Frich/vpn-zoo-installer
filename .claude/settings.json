{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(bash docker/test.sh *)",
      "Bash(docker/test.sh *)",
      "Bash(bash docker/run-server.sh *)",
      "Bash(docker/run-server.sh *)",
      "Bash(bash docker/tests/*)",
      "Bash(docker/tests/*)",
      "Bash(bash docker/probe/run.sh *)",
      "Bash(bash docker/lint.sh *)",
      "Bash(docker/lint.sh *)",
      "Bash(bash zoo/tests/web_smoke.sh *)",
      "Bash(docker ps *)",
      "Bash(docker images *)",
      "Bash(docker image inspect *)",
      "Bash(docker inspect *)",
      "Bash(docker logs *)",
      "Bash(python -m unittest *)",
      "Bash(python3 -m unittest *)",
      "Bash(bash -n *)",
      "Bash(sha256sum *)",
      "Bash(gh release view *)",
      "Bash(gh release list *)",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:xtls.github.io)",
      "WebFetch(domain:v2.hysteria.network)",
      "WebFetch(domain:docs.amnezia.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:go.dev)",
      "WebFetch(domain:ntc.party)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git stash drop *)",
      "Bash(rm -rf *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(docker rmi *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(gh api *)",
      "Bash(gh pr *)",
      "Bash(gh release create *)"
    ],
    "deny": [
      "Read(./probe/probe-export.json)",
      "Read(./.env)"
    ]
  }
}
