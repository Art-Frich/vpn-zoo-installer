# zoo-upstream — раз в сутки спрашивает GitHub, какие свежие версии у x-ui, xray, hysteria, AmneziaWG и sing-box
# (zoo upgrade --check-upstream), результат — /var/lib/vpn-zoo/upstream.json. Страница админки читает только его.
# Ничего не обновляет: версии меняются через пины репозитория (bump-pins, sha256).
[Unit]
Description=vpn-zoo: проверка свежих версий upstream
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/zoo upgrade --check-upstream
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2min
UMask=0077

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vpn-zoo
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
